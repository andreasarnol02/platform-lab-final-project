# Salin ke .env untuk kustomisasi: cp .env.example .env
# Base URL API marketplace (Express). Default ketika tidak diatur:
# - development via Expo: otomatis memakai host mesin dev (hostUri) port 4000
# - fallback: http://localhost:4000/api
# Untuk perangkat fisik: setel ke IP LAN mesin dev, mis. http://192.168.1.10:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
